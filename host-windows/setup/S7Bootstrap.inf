[Version]
Signature="$WINDOWS NT$"
Class=Extension
ClassGuid={e2f84ce7-8efa-411c-aa69-97454ca4cb57}
ExtensionId={854D8F9F-BF32-4A42-B346-1198B7E3D210}
Provider=%Provider%
DriverVer=09/24/2026,0.1.0.0
CatalogFile=S7Bootstrap.cat
PnpLockdown=1

[Manufacturer]
%Provider%=S7,NTamd64.10.0...22000

[S7.NTamd64.10.0...22000]
%DeviceName%=S7Install,USB\VID_04E8&PID_A7C1

[S7Install.NT]
CopyFiles=BootstrapFiles,DeliveryFiles,TransportFiles

[S7Install.NT.Services]
AddService=S7PackageBootstrap,0,BootstrapService

[BootstrapService]
DisplayName=%ServiceName%
ServiceType=0x10
StartType=3
ErrorControl=0
ServiceBinary=%13%\S7PackageBootstrap.exe
AddTrigger=BootstrapTrigger

[BootstrapTrigger]
TriggerType=1
Action=1
SubType={79D1B2BC-AB1A-4AB1-AE69-6FAB83AC15B0}

[DestinationDirs]
BootstrapFiles=13
DeliveryFiles=13,delivery
TransportFiles=13,delivery\monitor

[BootstrapFiles]
S7PackageBootstrap.exe

[DeliveryFiles]
PackageCommon.ps1
PackageState.ps1
PhonePackage.ps1
Sync-FromPhone.ps1
bundle.json
bundle.p7s

[TransportFiles]
DeviceIdentity.ps1
ReadOnlyDiagnostics.cs

[SourceDisksNames]
1=%MediaName%,,,

[SourceDisksFiles]
S7PackageBootstrap.exe=1
PackageCommon.ps1=1,delivery
PackageState.ps1=1,delivery
PhonePackage.ps1=1,delivery
Sync-FromPhone.ps1=1,delivery
bundle.json=1,delivery
bundle.p7s=1,delivery
DeviceIdentity.ps1=1,delivery\monitor
ReadOnlyDiagnostics.cs=1,delivery\monitor

[Strings]
Provider="S7 Appliance Project"
DeviceName="S7 package bootstrap"
ServiceName="S7 package bootstrap"
MediaName="S7 package bootstrap"
