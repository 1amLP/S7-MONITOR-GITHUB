; Appliance-specific extension to the original, pinned vendor policy.
; Not an Android application domain: no membership in domain/appdomain/coredomain,
; no inherited Android app grants or per-domain permissive mode. Every access
; for our two processes is declared here; original media domains stay unchanged.
; s7_native is the trusted hardware supervisor. s7_media_client is ONLY the
; broker/API client inside the already allowlisted mount/PID namespace.
(type s7_native)
(roletype r s7_native)
(type s7_media_client)
(roletype r s7_media_client)
(type s7_native_exec)
(typeattributeset file_type (s7_native_exec))
(typeattributeset exec_type (s7_native_exec))
(typeattributeset system_file_type (s7_native_exec))
(type s7_codec_exec)
(typeattributeset file_type (s7_codec_exec))
(typeattributeset exec_type (s7_codec_exec))
(typeattributeset system_file_type (s7_codec_exec))
(type s7_media_control)
(type s7_media_socket)
(type s7_native_cache)
(typeattributeset file_type (s7_native_cache))
(type s7_appliance_system)
(typeattributeset file_type (s7_appliance_system))
(type s7_gpu_system)
(typeattributeset file_type (s7_gpu_system))

; First load is BEFORE appliance workers, followed by exec, not a multithreaded
; setcon/dyntransition. The same pinned /init inode has a different transition
; when original private Android init execs it as the media broker.
(typetransition kernel s7_native_exec process s7_native)
(typetransition s7_native init_exec process init)
(typetransition init s7_native_exec process s7_media_client)
(typetransition s7_media_client s7_media_control sock_file s7_media_socket)
(allow kernel s7_native_exec (file (read getattr lock map open execute)))
(allow kernel s7_native (process (transition siginh rlimitinh)))
(allow s7_native s7_native_exec (file (entrypoint)))
(allow s7_native kernel (process (sigchld)))
(allow s7_native kernel (fd (use)))
(allow s7_native init_exec (file (read getattr lock map open execute)))
(allow s7_native init (process (transition siginh rlimitinh)))
