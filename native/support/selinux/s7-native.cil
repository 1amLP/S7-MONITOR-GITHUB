(allow s7_media_control tmpfs (filesystem (associate)))
(allow s7_media_socket tmpfs (filesystem (associate)))
; /proc/<pid> files have the process SID, not the generic proc filesystem type.
(allow s7_native self (dir (read getattr open search)))
(allow s7_native self (file (read write getattr open)))
; Owned DMA-BUF readback and the e418 retire-fence wait, not arbitrary ioctls.
(allow s7_native self (file (map ioctl)))
(allowx s7_native self (ioctl file (0x3e00)))
(allow s7_native self (lnk_file (read getattr)))
(allow s7_media_client self (dir (read getattr open search)))
(allow s7_media_client self (file (read write getattr open)))
(allow s7_media_client self (lnk_file (read getattr)))
(allow s7_media_client init (dir (read getattr open search)))
(allow s7_media_client init (file (read getattr open)))
(allow s7_media_client init (lnk_file (read getattr)))
(allow s7_media_client servicemanager (lnk_file (read getattr)))
(allow s7_media_client hwservicemanager (lnk_file (read getattr)))
(allow s7_media_client vndservicemanager (lnk_file (read getattr)))
(allow s7_media_client mediaserver (lnk_file (read getattr)))
(allow s7_media_client mediacodec (lnk_file (read getattr)))
(allow s7_media_client hal_allocator_default (lnk_file (read getattr)))
(allow s7_media_client hal_graphics_allocator_default (lnk_file (read getattr)))
; Read the exact service domain through /proc/PID/attr/current. No ptrace.
(allow s7_media_client servicemanager (process (getattr)))
(allow s7_media_client hwservicemanager (process (getattr)))
(allow s7_media_client vndservicemanager (process (getattr)))
(allow s7_media_client mediaserver (process (getattr)))
(allow s7_media_client mediacodec (process (getattr)))
(allow s7_media_client hal_allocator_default (process (getattr)))
(allow s7_media_client hal_graphics_allocator_default (process (getattr)))

; Explicit private root/seed mount targets. No mount permissions for client.
(allow s7_native apex_mnt_dir (dir (mounton)))
(allow s7_native linkerconfig_file (dir (mounton)))
(allow s7_native system_file (dir (mounton)))
(allow s7_native proc (dir (mounton)))
(allow s7_native sysfs (dir (mounton)))
(allow s7_native selinuxfs (dir (mounton)))
(allow s7_native system_data_root_file (dir (mounton)))
(allow s7_native rootfs (file (mounton)))
(allow s7_native s7_native_exec (file (mounton)))
(allow s7_native s7_codec_exec (file (mounton)))
(allow s7_native proc_sysrq (file (mounton)))
(allow s7_native proc_security (file (mounton write)))
; RAM-root fscontext and private CACHE context mounts require filesystem relabel
; checks as well as mount. This does not grant a block-device write to non-CACHE.
(allow s7_native tmpfs (filesystem (relabelfrom)))
(allow s7_native rootfs (filesystem (relabelto)))
(allow s7_native labeledfs (filesystem (relabelfrom)))
(allow s7_native s7_native_cache (filesystem (relabelto mount remount unmount getattr)))

; Bounded, anonymous CPU NV12 exchange between the two appliance domains.
; memfd uses a tmpfs inode. No Android media domain receives these file grants.
(type s7_codec_pixels)
(typeattributeset file_type (s7_codec_pixels))
(typetransition s7_media_client tmpfs file s7_codec_pixels)
(allow s7_media_client s7_codec_pixels (file (create read write getattr setattr map open)))
(allow s7_native s7_codec_pixels (file (read write getattr map)))
(allow s7_native s7_media_client (fd (use)))
(neverallow s7_native s7_codec_pixels (file (execute execute_no_trans)))
(neverallow s7_media_client s7_codec_pixels (file (execute execute_no_trans)))

; The data socket is created by the broker, not the outer PID1. SCM_RIGHTS
; preserves its creator SID: connectto alone does not authorize actual I/O.
(allow s7_native s7_media_client (unix_stream_socket (read write getattr getopt setopt shutdown)))

; Native sensor-hub branch. lhd does not remain in the privileged PID1 domain.
; Original ELF/config/hardware names are unchanged. The launcher creates a
; private network namespace, raises only lo there, then execs this fixed type.
(type s7_sensorhub)
(roletype r s7_sensorhub)
(type s7_hub_exec)
(typeattributeset file_type (s7_hub_exec))
(typeattributeset exec_type (s7_hub_exec))
(type s7_hub_library)
(typeattributeset file_type (s7_hub_library))
(type s7_hub_config)
(typeattributeset file_type (s7_hub_config))
(type s7_hub_state)
(typeattributeset file_type (s7_hub_state))
(typetransition s7_native s7_hub_exec process s7_sensorhub)
(allow s7_native s7_hub_exec (file (read getattr open map execute)))
; Sanitized argv/env and same UID/GID: retain only our fixed LD_LIBRARY_PATH.
; Without noatsecure, the bootstrap linker discards it on this transition.
(allow s7_native s7_sensorhub (process (transition noatsecure siginh rlimitinh signal sigkill getattr)))
(allow s7_native s7_sensorhub (dir (read getattr open search)))
(allow s7_native s7_sensorhub (file (read getattr open)))
(allow s7_native s7_sensorhub (lnk_file (read getattr)))
(allow s7_sensorhub s7_hub_exec (file (entrypoint read getattr open map execute)))
(allow s7_sensorhub s7_hub_library (file (read getattr open map execute)))
(allow s7_sensorhub s7_hub_config (file (read getattr open)))
(allow s7_sensorhub s7_native (process (sigchld)))
(allow s7_sensorhub s7_native (fd (use)))
(allow s7_sensorhub s7_native (fifo_file (read write getattr open)))
(allow s7_sensorhub s7_native (unix_stream_socket (read write getattr getopt setopt shutdown)))
(allow s7_sensorhub self (process (fork sigchld signal sigkill sigstop getpgid setpgid getsched setsched getcap getrlimit setrlimit)))
(allow s7_sensorhub self (fd (use)))
(allow s7_sensorhub self (file (read getattr open)))
(allow s7_sensorhub self (dir (read getattr open search)))
(allow s7_sensorhub self (capability (sys_nice net_bind_service)))
(allow s7_sensorhub self (capability2 (block_suspend)))
(allow s7_sensorhub self (fifo_file (read write create getattr open)))
(allow s7_sensorhub self (unix_stream_socket (create bind listen accept connect connectto read write getattr getopt setopt shutdown)))
(allow s7_sensorhub self (unix_dgram_socket (create bind connect sendto read write getattr getopt setopt shutdown)))
(allow s7_sensorhub self (tcp_socket (create bind connect listen accept read write getattr getopt setopt shutdown)))
(allow s7_sensorhub port (tcp_socket (name_bind name_connect)))
(allow s7_sensorhub node (tcp_socket (node_bind)))
; Only the supervisor's isolated child sets lo UP; lhd receives no net_admin.
(allow s7_native self (capability (net_admin)))
(allow s7_native self (unix_dgram_socket (ioctl)))
(allowx s7_native self (ioctl unix_dgram_socket (0x8913 0x8914)))
(allow s7_sensorhub file_type (dir (read getattr open search)))
(allow s7_sensorhub file_type (lnk_file (read getattr)))
(allow s7_sensorhub fs_type (dir (read getattr open search)))
(allow s7_sensorhub fs_type (lnk_file (read getattr)))
(allow s7_sensorhub proc (file (read getattr open)))
(allow s7_sensorhub proc_net (file (read getattr open)))
(allow s7_sensorhub proc_net_tcp_udp (file (read getattr open)))
(allow s7_sensorhub null_device (chr_file (read write getattr open)))
(allow s7_sensorhub zero_device (chr_file (read write getattr open map)))
(allow s7_sensorhub random_device (chr_file (read getattr open)))
(allow s7_sensorhub bbd_device (chr_file (read write getattr open ioctl lock)))
; Original TTY configuration; no blanket ioctl range on arbitrary devices.
(allowx s7_sensorhub bbd_device (ioctl chr_file (0x5401 0x5402 0x540b 0x5411 0x5415 0x541b 0x545d)))
(allow s7_sensorhub sysfs_bbd (file (read getattr open)))
(allow s7_sensorhub sysfs_sec_gps (file (read getattr open)))
(allow s7_sensorhub sysfs_sec_sensorhub (file (read write getattr open)))
(allow s7_sensorhub sysfs_sensorhub_writable (file (read write getattr open)))
(allow s7_sensorhub sysfs_gps_writable (file (read write getattr open)))
(allow s7_sensorhub sysfs_lhd (file (read write getattr open)))
(allow s7_sensorhub sysfs_wake_lock (file (read write getattr open)))
(allow s7_native sysfs_wake_lock (file (read write getattr open)))
; Mutable files/lock/FIFO are restricted to /run/s7-sensorhub, labelled before
; launch. No general tmpfs/rootfs writes, logd, Binder or partition access.
(allow s7_hub_state tmpfs (filesystem (associate)))
(allow s7_native s7_hub_state (dir (create read write getattr setattr open search add_name remove_name)))
(allow s7_native s7_hub_state (file (read write getattr open)))
(allow s7_sensorhub s7_hub_state (dir (read write create getattr setattr open search add_name remove_name rmdir)))
(allow s7_sensorhub s7_hub_state (file (read write create getattr setattr open lock append unlink rename)))
(allow s7_sensorhub s7_hub_state (fifo_file (read write create getattr setattr open lock append unlink)))
(allow s7_sensorhub s7_hub_state (sock_file (read write create getattr setattr open unlink)))
(typetransition s7_sensorhub s7_hub_state file s7_hub_state)
(typetransition s7_sensorhub s7_hub_state dir s7_hub_state)
(typetransition s7_sensorhub s7_hub_state fifo_file s7_hub_state)
(typetransition s7_sensorhub s7_hub_state sock_file s7_hub_state)
(neverallow s7_sensorhub kernel (security (load_policy setenforce)))
(neverallow s7_sensorhub self (capability (sys_admin net_admin sys_boot sys_ptrace)))
(neverallow s7_sensorhub sysfs_thermal (file (write append)))
(neverallow s7_sensorhub block_device (blk_file (read write append)))
(neverallow s7_sensorhub system_block_device (blk_file (read write append)))
(neverallow s7_sensorhub userdata_block_device (blk_file (read write append)))
(neverallow s7_sensorhub efs_block_device (blk_file (read write append)))
(neverallow s7_sensorhub cache_block_device (blk_file (read write append)))
(neverallow s7_sensorhub binder_device (chr_file (read write ioctl)))
(neverallow s7_sensorhub hwbinder_device (chr_file (read write ioctl)))
(neverallow s7_sensorhub video_device (chr_file (read write ioctl)))
(neverallow s7_sensorhub usb_device (chr_file (read write ioctl)))
(neverallow s7_sensorhub s7_hub_state (file (execute)))
